# .env.worker.example
# Copy file này thành .env.worker rồi điền giá trị thực:
#   cp .env.worker.example .env.worker
#
# Cách lấy Tailscale IP:
#   tailscale ip -4

# ── Kết nối tới máy 1 (main server) ──────────────────────────────────────────
# Thay 100.X.X.X bằng Tailscale IP của máy 1
CELERY_BROKER_URL=redis://100.X.X.X:6379/0
CELERY_RESULT_BACKEND=redis://100.X.X.X:6379/0

MINIO_ENDPOINT=100.X.X.X:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

API_INTERNAL_URL=http://100.X.X.X:8000
MLFLOW_TRACKING_URI=http://100.X.X.X:5000

# ── Cấu hình worker này ───────────────────────────────────────────────────────
# WORKER_NAME: tên hiển thị trong UI (phải unique giữa các máy)
# WORKER_HOST: Tailscale IP của máy 2 này (dùng để monitoring)
WORKER_NAME=gpu-server-1
WORKER_HOST=100.Y.Y.Y

EXPERIMENT_WORKDIR=/workspace/experiments

# GPU: đổi thành "all" nếu máy có GPU NVIDIA và đã cài NVIDIA Container Toolkit
NVIDIA_VISIBLE_DEVICES=void

# ── Cấu hình GPU (chỉ cần nếu NVIDIA_VISIBLE_DEVICES != void) ────────────────
# GPU_COUNT=1                 # số GPU trên máy này
# GPU_TYPE=RTX 4090           # tên GPU, hiển thị trong UI

# Ports của các exporter chạy trên máy 2 — dùng để monitoring trong UI
# NODE_EXPORTER_PORT=9100     # prom/node-exporter (CPU, RAM, Disk, Network)
# CADVISOR_PORT=8080          # cAdvisor (per-container metrics)
# DCGM_EXPORTER_PORT=9400     # nvidia/dcgm-exporter (GPU util, VRAM, temp...)

# ── Giới hạn thời gian chạy (tuỳ chọn) ──────────────────────────────────────
# TASK_SOFT_LIMIT_SEC=43200   # 12 giờ (mặc định)
# TASK_HARD_LIMIT_SEC=46800   # 13 giờ (mặc định)
