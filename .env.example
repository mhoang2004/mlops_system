# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mydb

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Remote worker endpoints (dùng khi có worker chạy trên máy khác, ví dụ qua Tailscale)
# Để trống nếu chỉ dùng local worker (Docker Compose trên cùng máy)
# MINIO_WORKER_ENDPOINT=100.X.X.X:9000   # Tailscale IP của máy 1, port MinIO
# API_WORKER_URL=http://100.X.X.X:8000   # Tailscale IP của máy 1, port API
