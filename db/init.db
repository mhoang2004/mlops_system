-- Table: projects
CREATE TABLE projects (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    labels JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Table: dataset_versions
CREATE TABLE dataset_versions (
    id SERIAL PRIMARY KEY,
    project_id INT NOT NULL,
    name VARCHAR(255) NOT NULL,
    version VARCHAR(50) NOT NULL,
    description TEXT,
    storage_path TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    label_type VARCHAR(50) DEFAULT 'unlabeled' NOT NULL,

    CONSTRAINT fk_project
        FOREIGN KEY (project_id)
        REFERENCES projects(id)
        ON DELETE CASCADE,

    CONSTRAINT unique_project_version_name
        UNIQUE (project_id, version, name)
);

-- Table: checkpoints
CREATE TABLE checkpoints (
    id SERIAL PRIMARY KEY,
    project_id INT,
    experiment_id INT,
    name VARCHAR(255) NOT NULL,
    source VARCHAR(50) DEFAULT 'pretrained' NOT NULL, -- 'pretrained' (model tải về/khởi tạo) hoặc 'experiment' (model tự train)
    file_path TEXT NOT NULL,
    metrics JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_checkpoint_project
        FOREIGN KEY (project_id)
        REFERENCES projects(id)
        ON DELETE CASCADE

    -- Nếu bạn tạo bảng 'experiments', hãy uncomment đoạn dưới đây:
    -- CONSTRAINT fk_checkpoint_experiment
    --     FOREIGN KEY (experiment_id)
    --     REFERENCES experiments(id)
    --     ON DELETE SET NULL
);

-- Index query
CREATE INDEX idx_dataset_project_id ON dataset_versions(project_id);
CREATE INDEX idx_labels_project_id ON labels(project_id);
CREATE INDEX idx_checkpoints_project_id ON checkpoints(project_id);
